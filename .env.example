# Backend Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────

# MongoDB connection string
MONGO_URI="mongodb+srv://straycare_db_user:StrayCare2025Db@cluster0.emptg6z.mongodb.net/straycare?retryWrites=true&w=majority&appName=Cluster0"
# Server config
PORT=5000
HOST=0.0.0.0

# JWT secret — use a strong random string in production
JWT_SECRET="straycare_dev_jwt_secret_key_2026_!"

# Server-only key restricted to Google Places API (New).
# Never expose this value through the mobile application.
GOOGLE_PLACES_API_KEY="YOUR_GOOGLE_PLACES_API_KEY"

# ──────────────────────────────────────────────────────────────────
# Firebase Admin SDK
# The service account key is loaded from:
#   src/config/serviceAccountKey.json
# Download it from: Firebase Console → Project Settings → Service Accounts
#
# If serviceAccountKey.json is missing, a fallback manual verification 
# will be used. You can configure the project ID below (defaults to straycareweb):
# FIREBASE_PROJECT_ID=straycareweb
# ──────────────────────────────────────────────────────────────────
