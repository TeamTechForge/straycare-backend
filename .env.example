# Backend Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────

# MongoDB connection string
MONGO_URI=
# Server config
PORT=
HOST=

# JWT secret — use a strong random string in production
JWT_SECRET=

# ──────────────────────────────────────────────────────────────────
# Firebase Admin SDK
# The service account key is loaded from:
#   src/config/serviceAccountKey.json
# Download it from: Firebase Console → Project Settings → Service Accounts
#
# If serviceAccountKey.json is missing, a fallback manual verification 
# will be used. You can configure the project ID below (defaults to straycareweb):
# FIREBASE_PROJECT_ID=straycareweb
# ──────────────────────────────────────────────────────────────────
MESSAGE_ENCRYPTION_KEY=